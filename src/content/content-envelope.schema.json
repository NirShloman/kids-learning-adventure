{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lomdim-bekef.local/content-envelope.schema.json",
  "type": "object",
  "required": ["schemaVersion", "contentVersion", "gameId", "items"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "contentVersion": { "type": "string", "minLength": 1 },
    "gameId": { "enum": ["letters", "numbers", "shapes", "colors", "matching", "memory", "patterns", "sorting"] },
    "items": {
      "type": "array",
      "minItems": 90,
      "items": {
        "type": "object",
        "required": ["id", "ages", "difficulty", "skill", "skillIds", "evidenceForm"],
        "properties": {
          "id": { "type": "string", "minLength": 4 },
          "ages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": [3, 4, 5, 6] }
          },
          "difficulty": { "enum": ["easy", "medium", "hard"] },
          "skill": { "type": "string", "minLength": 2 },
          "skillIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
          "evidenceForm": { "enum": ["visual-choice", "listening-choice", "matching", "memory", "sequence", "sorting", "adventure-drag", "adventure-navigation", "shared-turn", "shared-cooperation"] }
        }
      }
    }
  }
}
