{
  "name": "kids-learning-adventure-web",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "אפליקציית Web/PWA משודרגת ללימוד חוויתי בעברית לילדים בגילאי 3-6, עם קול הדרכה, לובי עשיר, אנימציות, משחקים נוספים ומאגר שאלות מורחב.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && npm run validate:privacy && tsc -b && vite build && node scripts/finalize-service-worker.mjs",
    "build:web": "npm run build",
    "build:native": "npm run build && npm run cap:sync",
    "cap:sync": "cap sync",
    "android:bundle": "npm run build:native && node scripts/run-gradle.mjs bundleRelease",
    "ios:archive": "npm run build:native && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Release -archivePath build/LomdimBekef.xcarchive archive",
    "mobile:verify": "node scripts/verify-mobile-config.mjs",
    "mobile:assets": "node scripts/generate-mobile-assets.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "generate:content": "node scripts/generate-static-content.mjs",
    "generate:recordings": "node scripts/generate-recording-list.mjs",
    "validate:questions": "node scripts/validate-static-content.mjs",
    "validate:content": "node scripts/validate-static-content.mjs && tsx scripts/validate-learning-model.mts && node scripts/validate-hebrew-narration.mjs && tsx scripts/validate-narration-manifest.mts && node scripts/validate-experience-assets.mjs && node scripts/validate-audio-assets.mjs",
    "validate:assets": "node scripts/validate-experience-assets.mjs",
    "build:experience-assets": "python scripts/build_character_atlases.py && node scripts/build-experience-props.mjs",
    "validate:narration": "node scripts/validate-hebrew-narration.mjs",
    "validate:audio": "node scripts/validate-audio-assets.mjs",
    "validate:privacy": "node scripts/validate-local-privacy.mjs",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:offline": "node scripts/offline-smoke.mjs",
    "test:e2e": "playwright test --project=local-chromium --project=local-firefox --project=local-webkit --project=mobile-chrome --project=mobile-safari --project=mobile-android-tablet --project=mobile-ipad",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.local.spec.ts --project=local-chromium --project=mobile-chrome",
    "test:e2e:visual": "playwright test tests/e2e/experience-visual.local.spec.ts --project=local-chromium --project=mobile-chrome",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:local": "playwright test --project=local-chromium --project=local-firefox --project=local-webkit --project=mobile-chrome --project=mobile-safari --project=mobile-android-tablet --project=mobile-ipad",
    "test:e2e:debug": "playwright test --project=local-chromium --debug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.0.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@capacitor/splash-screen": "8.0.1",
    "@fontsource/rubik": "^5.3.0",
    "@rive-app/react-webgl2": "^4.29.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "matter-js": "^0.20.0",
    "motion": "^12.42.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "^1.60.0",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^25.9.1",
    "ajv": "^8.20.0",
    "jsdom": "^29.1.1",
    "sharp": "0.35.3",
    "tsx": "^4.20.6",
    "vitest": "^4.0.14",
    "wrangler": "^4.112.0"
  }
}
