default_platform(:android)

platform :android do
  desc "Build a signed Android App Bundle and publish it to Internal Testing"
  lane :beta do
    gradle(project_dir: "android", task: "clean bundleRelease")
    upload_to_play_store(
      package_name: "com.nirshloman.lomdimbekef",
      track: "internal",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      json_key: ENV.fetch("GOOGLE_PLAY_SERVICE_ACCOUNT_PATH"),
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  desc "Build a signed IPA and publish it to the internal TestFlight group"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8_BASE64"),
      is_key_content_base64: true
    )
    increment_build_number(
      build_number: ENV.fetch("GITHUB_RUN_NUMBER"),
      xcodeproj: "ios/App/App.xcodeproj"
    )
    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ios",
      output_name: "LomdimBekef.ipa",
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
      export_options: {
        provisioningProfiles: {
          "com.nirshloman.lomdimbekef" => ENV.fetch("APPLE_PROVISIONING_PROFILE_NAME")
        }
      }
    )
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/ios/LomdimBekef.ipa",
      distribute_external: false,
      groups: [ENV.fetch("TESTFLIGHT_INTERNAL_GROUP", "Internal Testers")],
      skip_waiting_for_build_processing: true
    )
  end
end
