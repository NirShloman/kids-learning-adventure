{
  "name": "olamia-pilot-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "provision": "tsx scripts/provision.mts",
    "test:emulator": "firebase emulators:exec --config ../firebase.pilot.json --project demo-olamia-pilot --only auth,firestore,functions \"node --import tsx --test tests/emulator.test.mts\""
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "firebase": "12.19.0",
    "firebase-tools": "^15.28.2",
    "tsx": "^4.20.6",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "@firebase/app": "0.16.2"
  }
}
