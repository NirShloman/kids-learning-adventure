{
  "name": "kids-learning-adventure-web",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "אפליקציית Web/PWA משודרגת ללימוד חוויתי בעברית לילדים בגילאי 3-6, עם קול הדרכה, לובי עשיר, אנימציות, משחקים נוספים ומאגר שאלות מורחב.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "generate:content": "node scripts/generate-static-content.mjs",
    "validate:questions": "node scripts/validate-static-content.mjs",
    "validate:content": "node scripts/validate-static-content.mjs",
    "test:unit": "vitest run tests/unit",
    "test:offline": "node scripts/offline-smoke.mjs",
    "test:e2e": "playwright test --project=local-chromium --project=local-firefox --project=local-webkit --project=mobile-chrome --project=mobile-safari",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:local": "playwright test --project=local-chromium --project=local-firefox --project=local-webkit --project=mobile-chrome --project=mobile-safari",
    "test:e2e:debug": "playwright test --project=local-chromium --debug"
  },
  "dependencies": {
    "@fontsource/rubik": "^5.3.0",
    "@rive-app/react-webgl2": "^4.29.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "ajv": "^8.20.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.6",
    "vitest": "^4.0.14"
  }
}
