rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return signedIn() && ownerId == request.auth.uid;
    }

    function validDifficulty(value) {
      return value in ['easy', 'medium', 'hard'];
    }

    function validGameId(value) {
      return value in ['letters', 'numbers', 'shapes', 'colors', 'matching', 'memory', 'patterns', 'sorting'];
    }

    function validSyncStatus(value) {
      return value in ['local', 'pending', 'synced'];
    }

    function validPlayer(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'age', 'difficulty', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'name', 'age', 'difficulty', 'createdAt'])
        && data.id is string
        && data.ownerId is string
        && data.name is string
        && data.name.size() <= 50
        && data.age in [3, 4, 5, 6]
        && validDifficulty(data.difficulty)
        && data.createdAt is string;
    }

    function validSession(data) {
      return data.keys().hasAll(['id', 'ownerId', 'playerId', 'gameId', 'gameTitle', 'age', 'difficulty', 'score', 'total', 'stars', 'completedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'playerId', 'gameId', 'gameTitle', 'age', 'difficulty', 'score', 'total', 'stars', 'completedAt', 'syncStatus'])
        && data.id is string
        && data.ownerId is string
        && data.playerId is string
        && validGameId(data.gameId)
        && data.gameTitle is string
        && data.gameTitle.size() <= 80
        && data.age in [3, 4, 5, 6]
        && validDifficulty(data.difficulty)
        && data.score is int
        && data.total is int
        && data.score >= 0
        && data.total > 0
        && data.score <= data.total
        && data.stars in [1, 2, 3]
        && (!data.keys().hasAny(['syncStatus']) || validSyncStatus(data.syncStatus))
        && data.completedAt is string;
    }

    match /questionBank/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /players/{playerId} {
      allow create: if isOwner(request.resource.data.ownerId) && validPlayer(request.resource.data);
      allow read, delete: if isOwner(resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId)
        && isOwner(request.resource.data.ownerId)
        && validPlayer(request.resource.data);
    }

    match /sessions/{sessionId} {
      allow create: if isOwner(request.resource.data.ownerId) && validSession(request.resource.data);
      allow read, delete: if isOwner(resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId)
        && isOwner(request.resource.data.ownerId)
        && validSession(request.resource.data);
    }

    match /parents/{parentId} {
      allow read, write: if isOwner(parentId);

      match /children/{childId} {
        allow read, write: if isOwner(parentId);
      }

      match /sessions/{sessionId} {
        allow read, write: if isOwner(parentId);
      }
    }
  }
}
